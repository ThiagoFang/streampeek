{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StreamPeek",
  "version": "0.1.0",
  "identifier": "com.streampeek.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run vite build"
  },
  "app": {
    "windows": [
      {
        "title": "StreamPeek",
        "width": 280,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/logo_streampeek_white.png",
      "tooltip": "StreamPeek",
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
