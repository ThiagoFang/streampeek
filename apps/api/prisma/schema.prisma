generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
  output = "../src/db/generated"
  fileName = "types.ts"
}

datasource db {
  provider = "postgresql"
}

model AuthToken {
  id              Int      @id @default(autoincrement())
  sessionId       String   @unique @map("session_id")
  accessToken     String   @map("access_token")
  refreshToken    String   @map("refresh_token")
  userId          String   @unique @map("user_id")
  userLogin       String   @map("user_login")
  userDisplayName String   @map("user_display_name")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("auth_tokens")
}

model UserSettings {
  id                   Int      @id @default(autoincrement())
  userId               String   @unique @map("user_id")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_settings")
}

model NotificationExclusion {
  id               Int    @id @default(autoincrement())
  userId           String @map("user_id")
  broadcasterId    String @map("broadcaster_id")
  broadcasterLogin String @map("broadcaster_login")
  broadcasterName  String @map("broadcaster_name")

  @@unique([userId, broadcasterId])
  @@map("notification_exclusions")
}