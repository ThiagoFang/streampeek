{
  "name": "@streampeek/api",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc/router": "./src/rpc/router.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "bunx prisma db push --config prisma/prisma.config.ts",
    "db:generate": "bunx prisma generate --config prisma/prisma.config.ts"
  },
  "dependencies": {
    "@orpc/server": "^1.13.9",
    "@prisma/client": "^7.4.2",
    "arktype": "^2",
    "bullmq": "^5.28.2",
    "hono": "^4",
    "ioredis": "^5.4.2",
    "kysely": "^0.28.11",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "redaxios": "^0.5.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/pg": "^8.18.0",
    "prisma": "^7.4.2",
    "prisma-kysely": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
